generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Filme  {
  id        Int  @id @default(autoincrement())    
  titulo    String         
  imagem    String
  nota      Float    

  userId    Int
  user      User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senha     String   

  filmes    Filme[]

  createdAt DateTime @default(now())
}